//! Safe Rust binding to ARPACK-ng
//!
//! ARPACK-ng is a collection of Fortran77 subroutines designed to solve large scale eigenvalue problems.
//!
//! This crate provides a safe Rust interface to ARPACK-ng.

pub use arpack_ng_sys as arpack_int;

/// Operator trait for eigenvalue problems
///
/// This trait represents an operator that can be applied to a vector.
pub trait Operator<T> {
    /// Apply the operator to a vector
    fn apply(&self, x: &[T], y: &mut [T]);
}

/// Which eigenvalues to compute
#[derive(Debug, Clone, Copy, PartialEq)]
pub enum Which {
    /// Largest algebraic eigenvalues
    LA,
    /// Smallest algebraic eigenvalues
    SA,
    /// Largest magnitude eigenvalues
    LM,
    /// Smallest magnitude eigenvalues
    SM,
    /// Largest real part eigenvalues
    LR,
    /// Smallest real part eigenvalues
    SR,
    /// Largest imaginary part eigenvalues
    LI,
    /// Smallest imaginary part eigenvalues
    SI,
    /// Both ends of the spectrum
    BE,
}

impl Which {
    fn as_str(&self) -> &'static str {
        match self {
            Which::LA => "LA",
            Which::SA => "SA",
            Which::LM => "LM",
            Which::SM => "SM",
            Which::LR => "LR",
            Which::SR => "SR",
            Which::LI => "LI",
            Which::SI => "SI",
            Which::BE => "BE",
        }
    }
}

/// Configuration for the ARPACK solver
pub struct Config {
    which: Which,
    ncv: Option<usize>,
    tol: f64,
    max_iter: usize,
}

impl Default for Config {
    fn default() -> Self {
        Config {
            which: Which::LM,
            ncv: None,
            tol: 0.0,
            max_iter: 1000,
        }
    }
}

impl Config {
    /// Create a new configuration with default values
    pub fn new() -> Self {
        Default::default()
    }

    /// Set which eigenvalues to compute
    pub fn which(mut self, which: Which) -> Self {
        self.which = which;
        self
    }

    /// Set the number of Lanczos vectors to use
    pub fn ncv(mut self, ncv: usize) -> Self {
        self.ncv = Some(ncv);
        self
    }

    /// Set the tolerance for convergence
    pub fn tol(mut self, tol: f64) -> Self {
        self.tol = tol;
        self
    }

    /// Set the maximum number of iterations
    pub fn max_iter(mut self, max_iter: usize) -> Self {
        self.max_iter = max_iter;
        self
    }
}

/// Result of the eigenvalue computation
pub struct EigsResult<T> {
    /// Eigenvalues
    pub values: Vec<T>,
    /// Eigenvectors (column-major)
    pub vectors: Vec<T>,
}

/// Compute eigenvalues and eigenvectors of a symmetric operator
pub fn eigs<O>(op: O, n:usize,  nev: usize, config: Config) -> Result<EigsResult<f64>, &'static str>
where
    O: Operator<f64>,
{
    let which = config.which.as_str().as_ptr() as *const ::std::os::raw::c_char;
    let ncv = config.ncv.unwrap_or_else(|| std::cmp::min(2 * nev + 1, n));
    let tol = config.tol;
    let maxiter = config.max_iter;
    
    // Allocate workspace
    let mut ido = 0;
    let bmat = "I".as_ptr() as *const ::std::os::raw::c_char; // Standard eigenvalue problem
    let mut resid = vec![0.0; n];
    let mut v = vec![0.0; n * ncv];
    let mut iparam = [0; 11];
    iparam[0] = 1; // Exact shifts
    iparam[2] = maxiter as i32;
    iparam[6] = 1; // Mode 1: A*x = lambda*x
    
    let mut ipntr = [0; 14];
    let mut workd = vec![0.0; 3 * n];
    let lworkl = ncv * (ncv + 8);
    let mut workl = vec![0.0; lworkl];
    let mut info = 0;
    
    // ARPACK reverse communication interface
    loop {
        unsafe {
            arpack_int::dsaupd_c(
                &mut ido,
                bmat,
                n as i32,
                which,
                nev as i32,
                tol,
                resid.as_mut_ptr(),
                ncv as i32,
                v.as_mut_ptr(),
                n as i32,
                iparam.as_mut_ptr(),
                ipntr.as_mut_ptr(),
                workd.as_mut_ptr(),
                workl.as_mut_ptr(),
                lworkl as i32,
                &mut info,
            );
        }
        
        if ido == 99 {
            break;
        }
        
        if ido == -1 || ido == 1 {
            let x_start = (ipntr[0] - 1) as usize;
            let y_start = (ipntr[1] - 1) as usize;
            
            // Create a temporary buffer to hold the input vector
            let mut x_temp = vec![0.0; n];
            x_temp.copy_from_slice(&workd[x_start..x_start + n]);
            
            // Now we can safely get a mutable reference to the output part
            let y = &mut workd[y_start..y_start + n];
            
            // Apply the operator
            op.apply(&x_temp, y);
        } else {
            return Err("Unexpected IDO value");
        }
    }

    if info < 0 {
        return Err(match info {
            -1 => "N must be positive",
            -2 => "NEV must be positive",
            -3 => "NCV must be greater than NEV and less than or equal to N",
            -4 => "Maximum number of iterations must be greater than 0",
            -5 => "WHICH must be one of 'LM', 'SM', 'LA', 'SA', 'BE', 'LR', 'SR', 'LI', 'SI'",
            -6 => "BMAT must be one of 'I' or 'G'",
            -7 => "Length of private work array WORKL is not suarpack_intcient",
            -8 => "Error return from trid. eigenvalue calculation",
            -9 => "Starting vector is zero",
            -10 => "IPARAM(7) must be 1, 2, 3, 4, 5",
            -11 => "IPARAM(7) = 1 and BMAT = 'G' are incompatible",
            -12 => "IPARAM(1) must be equal to 0 or 1",
            -13 => "NEV and WHICH = 'BE' are incompatible",
            -9999 => "Could not build an Arnoldi factorization",
            _ => "Unknown DSAUPD error",
        });
}
    
    // Extract eigenvalues and eigenvectors
    let rvec = 1; // Compute eigenvectors
    let howmny = "A".as_ptr() as *const ::std::os::raw::c_char; // Compute all eigenvectors
    let mut select = vec![0; ncv];
    let mut d = vec![0.0; nev];
    let mut z = vec![0.0; n * nev];
    let sigma = 0.0;
    
    unsafe {
        arpack_int::dseupd_c(
            rvec,
            howmny,
            select.as_mut_ptr(),
            d.as_mut_ptr(),
            z.as_mut_ptr(),
            n as i32,
            sigma,
            bmat,
            n as i32,
            which,
            nev as i32,
            tol,
            resid.as_mut_ptr(),
            ncv as i32,
            v.as_mut_ptr(),
            n as i32,
            iparam.as_mut_ptr(),
            ipntr.as_mut_ptr(),
            workd.as_mut_ptr(),
            workl.as_mut_ptr(),
            lworkl as i32,
            &mut info,
        );
    }
    
    if info != 0 {
        return Err("DSEUPD error");
    }
    
    Ok(EigsResult {
        values: d,
        vectors: z,
    })
}