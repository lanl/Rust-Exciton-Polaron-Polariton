extern crate bindgen;
extern crate pkg_config;

#[cfg(feature = "cmake")]
extern crate cmake;

use std::env;
use std::path::PathBuf;

fn main() {
    println!("cargo:rerun-if-changed=wrapper.h");

    // Determine include paths for bindgen
    let mut include_paths = Vec::new();
    
    // Add system include paths
    include_paths.push("/opt/homebrew/include".to_string());
    include_paths.push("/usr/local/include".to_string());
    include_paths.push("/usr/include".to_string());
    
    #[cfg(feature = "system")]
    {
        // Try to use pkg-config to find the system ARPACK
        match pkg_config::Config::new().probe("arpack") {
            Ok(lib) => {
                for path in &lib.include_paths {
                    let path_str = path.to_string_lossy().to_string();
                    include_paths.push(path_str);
                    println!("cargo:include={}", path.display());
                }
                // Link against the library
                println!("cargo:rustc-link-search=native=/opt/homebrew/lib");
                println!("cargo:rustc-link-lib=arpack");
            }
            Err(e) => {
                eprintln!("pkg-config failed: {}", e);
                // If pkg-config fails, try to use the environment variable
                if let Ok(lib_path) = env::var("ARPACK_LIBRARY_PATH") {
                    println!("cargo:rustc-link-search=native={}", lib_path);
                    println!("cargo:rustc-link-lib=arpack");
                } else {
                    eprintln!("ARPACK_LIBRARY_PATH not set");
                }
            }
        }
    }

    // Generate bindings to arpack
    let mut builder = bindgen::Builder::default()
        .header("wrapper.h");
    
    // Add include paths
    for path in &include_paths {
        builder = builder.clang_arg(format!("-I{}", path));
    }
    
    // Try to generate bindings
    let bindings = builder
        .generate()
        .expect("Unable to generate bindings");

    // Write the bindings to the $OUT_DIR/bindings.rs file.
    let out_path = PathBuf::from(env::var("OUT_DIR").unwrap());
    bindings
        .write_to_file(out_path.join("bindings.rs"))
        .expect("Couldn't write bindings!");
}
