set terminal pdfcairo enhanced font 'Arial,40' size 16,12 background rgb '#000000'
set output 'output_figures/n_colored_band_structure_a016_v00.05.pdf'
set lmargin 10
set rmargin 10
set tmargin 3
set bmargin 3
set title 'Exciton Band Structure (a₀=16.0, V₀=0.1)' font 'Arial,16'
set xlabel 'Wave vector'
set ylabel 'Energy (a.u.)'
set xrange [0:0.6703792653336217]
set yrange [-0.22341430140372553:0.0730599768208947]
set palette rgbformulae 22,13,-22
set colorbox vertical user origin 0.88,0.1 size 0.03,0.8
set cbrange [0.0010493198024352174:3.999302178656977]
set cblabel 'Principal Quantum Number (n)' offset 2,0 textcolor rgb '#e0e0e0'
set cbtics 1
set xtics textcolor rgb '#e0e0e0'
set ytics textcolor rgb '#e0e0e0'
set border linecolor rgb '#808080'
set xtics ('Γ' 0, 'X' 0.19634954084936207, 'M' 0.3926990816987237, 'Γ' 0.6703792653336217)
set arrow from 0,-0.22341430140372553 to 0,0.0730599768208947 nohead lc rgb '#888888' lw 6
set arrow from 0.19634954084936207,-0.22341430140372553 to 0.19634954084936207,0.0730599768208947 nohead lc rgb '#888888' lw 6
set arrow from 0.3926990816987237,-0.22341430140372553 to 0.3926990816987237,0.0730599768208947 nohead lc rgb '#888888' lw 6
set arrow from 0.6703792653336217,-0.22341430140372553 to 0.6703792653336217,0.0730599768208947 nohead lc rgb '#888888' lw 6
