set terminal pdfcairo enhanced font 'Arial,40' size 16,12 background rgb '#000000'
set output 'sing_ex_color_disp_plot_0.015_n23_zoomed.pdf'
set lmargin 10
set rmargin 10
set tmargin 3
set bmargin 3
set title 'Exciton-Polariton Band Structure (a₀=9.0, V₀=0.1, g=0.001)' font 'Arial,16' textcolor rgb '#e0e0e0'
set xlabel 'Wave vector' textcolor rgb '#e0e0e0'
set ylabel 'Energy (a.u.)' textcolor rgb '#e0e0e0'
set xrange [0:0.08726646259971649]
set yrange [-0.195:-0.16]
set palette rgbformulae 22,13,-22
set colorbox vertical user origin 0.88,0.1 size 0.03,0.8
set cbrange [0:1]
set cblabel 'Photonic Character' offset 2,0 textcolor rgb '#e0e0e0'
set cbtics 0.2 textcolor rgb '#e0e0e0'
set xtics textcolor rgb '#e0e0e0'
set ytics textcolor rgb '#e0e0e0'
set border linecolor rgb '#808080'
# Define RGB components for our color gradient - exactly matching the palette
set angle degrees
r(x) = 3*x-1 < 0 ? 0: (3*x-1 > 1) ? 1 : 3*x-1
g(x) = sin(180*x)
b(x) = 1-(3*x-1) < 0 ? 0: (1-(3*x-1) > 1) ? 1 : 1-(3*x-1)
# Define transparency function based on photonic character
alpha(x) = x > 0.9 ? int(((x-0.9)/0.1*0.95)*255) : 0
# Create full ARGB color
myColor(x) = (alpha(x)<<24) + (int(r(x)*0xff)<<16) + (int(g(x)*0xff)<<8) + int(b(x)*0xff)
# Create a dummy file for the colorbar
set xtics ('Γ' 0, 'X' 0.029088820866572163, 'M' 0.058177641733144325)
plot 'gnuplot_data/colorbar.dat' using 1:2:3 with points pt 7 ps 0 lc palette notitle, 'gnuplot_data/band_0.dat' using 1:2:(myColor($3)) with lines lw 16 lc rgb var notitle, 'gnuplot_data/band_1.dat' using 1:2:(myColor($3)) with lines lw 16 lc rgb var notitle, 'gnuplot_data/band_2.dat' using 1:2:(myColor($3)) with lines lw 16 lc rgb var notitle, 'gnuplot_data/band_3.dat' using 1:2:(myColor($3)) with lines lw 16 lc rgb var notitle, 'gnuplot_data/band_4.dat' using 1:2:(myColor($3)) with lines lw 16 lc rgb var notitle, 'gnuplot_data/band_5.dat' using 1:2:(myColor($3)) with lines lw 16 lc rgb var notitle, 'gnuplot_data/band_6.dat' using 1:2:(myColor($3)) with lines lw 16 lc rgb var notitle, 'gnuplot_data/band_7.dat' using 1:2:(myColor($3)) with lines lw 16 lc rgb var notitle, 'gnuplot_data/band_8.dat' using 1:2:(myColor($3)) with lines lw 16 lc rgb var notitle, 'gnuplot_data/band_9.dat' using 1:2:(myColor($3)) with lines lw 16 lc rgb var notitle, 'gnuplot_data/band_10.dat' using 1:2:(myColor($3)) with lines lw 16 lc rgb var notitle, 'gnuplot_data/band_11.dat' using 1:2:(myColor($3)) with lines lw 16 lc rgb var notitle, 'gnuplot_data/band_12.dat' using 1:2:(myColor($3)) with lines lw 16 lc rgb var notitle, 'gnuplot_data/band_13.dat' using 1:2:(myColor($3)) with lines lw 16 lc rgb var notitle, 'gnuplot_data/band_14.dat' using 1:2:(myColor($3)) with lines lw 16 lc rgb var notitle, 'gnuplot_data/band_15.dat' using 1:2:(myColor($3)) with lines lw 16 lc rgb var notitle, 'gnuplot_data/band_16.dat' using 1:2:(myColor($3)) with lines lw 16 lc rgb var notitle, 'gnuplot_data/band_17.dat' using 1:2:(myColor($3)) with lines lw 16 lc rgb var notitle, 'gnuplot_data/band_18.dat' using 1:2:(myColor($3)) with lines lw 16 lc rgb var notitle, 'gnuplot_data/band_19.dat' using 1:2:(myColor($3)) with lines lw 16 lc rgb var notitle, 'gnuplot_data/band_20.dat' using 1:2:(myColor($3)) with lines lw 16 lc rgb var notitle, 'gnuplot_data/band_21.dat' using 1:2:(myColor($3)) with lines lw 16 lc rgb 