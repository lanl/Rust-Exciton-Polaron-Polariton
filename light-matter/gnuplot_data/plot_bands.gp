set terminal pngcairo enhanced font 'Arial,12' size 1200,900
set output 'sing_ex_color_disp_plot.png'
set title 'Exciton-Polariton Band Structure (a₀=9.0, V₀=0.1, g=0.005)' font 'Arial,16'
set xlabel 'Wave vector'
set ylabel 'Energy (a.u.)'
set xrange [0:1.1917853605931072]
set yrange [-0.41126961323516437:0.3338699815826269]
set palette defined (0 'blue', 0.5 'purple', 1 'red')
set colorbox
set cbrange [0:1]
set cblabel 'Photonic Character'
set xtics ('Γ' 0, 'X' 0.3490658503988659, 'M' 0.6981317007977321)
set arrow from 0,-0.41126961323516437 to 0,0.3338699815826269 nohead lc rgb '#888888'
set arrow from 0.3490658503988659,-0.41126961323516437 to 0.3490658503988659,0.3338699815826269 nohead lc rgb '#888888'
set arrow from 0.6981317007977321,-0.41126961323516437 to 0.6981317007977321,0.3338699815826269 nohead lc rgb '#888888'
